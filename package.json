{
  "name": "mdrawing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx src/security/serverAuth.test.ts && tsx src/security/accountManagement.test.ts && tsx src/security/quotationPermissions.test.ts && tsx src/engine/workflow/projectWorkflow.test.ts && tsx src/security/dirtyDozenTest.ts && tsx src/security/exportSecurityTest.ts && tsx src/engine/ai/aiSafetyTest.ts && tsx src/engine/pdfTemplateParser.test.ts && tsx scripts/negative-testing.ts && tsx scripts/audit-contrast.ts",
    "test:security:emulator": "firebase emulators:exec --project demo-mdrawing-repair --only firestore,storage \"vitest run tests/repair.integration.test.ts tests/storage.integration.test.ts --configLoader runner\"",
    "test:all": "npm run check:local && npm run test:security:emulator",
    "seed:owner": "tsx server/scripts/seedOwner.ts",
    "test:pdf": "vitest run src/lib/pdfGenerator.test.ts --configLoader runner",
    "test:batch": "vitest run tests/batching.test.ts --configLoader runner",
    "test:integration": "vitest run tests/repair.integration.test.ts --configLoader runner",
    "test:http": "node scripts/smoke-http.mjs",
    "check:local": "npm run lint && npm test && npm run test:pdf && npm run test:batch && npm run build && npm --prefix functions run build && npm run test:http"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/pdf-parse": "^1.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.0.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.87.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.2",
    "vite": "^6.2.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/uuid": "^11.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.34.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0"
  },
  "packageManager": "npm@11.19.0"
}
