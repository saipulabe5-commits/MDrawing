rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // ZERO-TRUST SECURITY HELPER FUNCTIONS
    // -------------------------------------------------------------
    
    function isSignedIn() { 
      return request.auth != null && request.auth.uid != null; 
    }

    function incoming() { 
      return request.resource.data; 
    }

    function existing() { 
      return resource.data; 
    }

    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwnerEmail(email) {
      return email != null && (
        email.lower() == 'saipulabe5@gmail.com' ||
        email.lower() == 'saipulabe@gmail.com'
      );
    }

    function isPrincipalActive() {
      return isSignedIn()
        && (
          (request.auth.token.email != null && isOwnerEmail(request.auth.token.email))
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && getUserDoc().get('isActive', false) == true
          )
        );
    }

    function hasOwnerCustomClaim() { 
      return isPrincipalActive()
        && request.auth.token.role == "OWNER" 
        && getUserDoc().get('role', '') == "OWNER"; 
    }

    function getPrincipalRole() {
      return (request.auth.token.email != null && isOwnerEmail(request.auth.token.email))
        ? "OWNER"
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? getUserDoc().get('role', 'VIEWER')
          : (request.auth.token.role == "OWNER" ? "OWNER" : "VIEWER"));
    }

    function isOwnerOrAdmin() {
      return isPrincipalActive() && (getPrincipalRole() in ["OWNER", "ADMIN"]);
    }

    function isCompanyWideFinanceRole() {
      return isPrincipalActive() && (getPrincipalRole() in ["OWNER", "ADMIN"]);
    }

    function hasExplicitDeny(capName) {
      return getUserDoc().get(capName, true) == false;
    }

    function canViewFinance() {
      return isPrincipalActive() && (
        getPrincipalRole() == "OWNER"
        || (
          !hasExplicitDeny('canViewFinance')
          && (
            getUserDoc().get('canViewFinance', false) == true
            || getPrincipalRole() in ["ADMIN", "FINANCE"]
          )
        )
      );
    }

    function canEditFinance() {
      return isPrincipalActive() && (
        getPrincipalRole() == "OWNER"
        || (
          !hasExplicitDeny('canEditFinance')
          && (
            getUserDoc().get('canEditFinance', false) == true
            || getPrincipalRole() in ["ADMIN", "FINANCE"]
          )
        )
      );
    }

    function canApproveFinance() {
      return isPrincipalActive() && (
        getPrincipalRole() == "OWNER"
        || (
          !hasExplicitDeny('canApproveFinance')
          && (
            getUserDoc().get('canApproveFinance', false) == true
            || getPrincipalRole() in ["ADMIN"]
          )
        )
      );
    }

    function canViewVendorCost() {
      return isPrincipalActive() && (
        getPrincipalRole() == "OWNER"
        || (
          !hasExplicitDeny('canViewVendorCost')
          && (
            getUserDoc().get('canViewVendorCost', false) == true
            || (getPrincipalRole() in ["ADMIN", "FINANCE"] && canViewFinance())
          )
        )
      );
    }

    function canViewVendorPayment() {
      return isPrincipalActive() && (
        getPrincipalRole() == "OWNER"
        || (
          !hasExplicitDeny('canViewVendorPayment')
          && (
            getUserDoc().get('canViewVendorPayment', false) == true
            || (getPrincipalRole() in ["ADMIN", "FINANCE"] && canViewFinance())
          )
        )
      );
    }

    function canManageTransmittal() {
      return isPrincipalActive() && (
        getPrincipalRole() == "OWNER"
        || (
          !hasExplicitDeny('canManageTransmittal')
          && (
            getUserDoc().get('canManageTransmittal', false) == true
            || getPrincipalRole() in ["ADMIN", "PROJECT_LEADER"]
          )
        )
      );
    }


    function hasAssociatedProject(data) {
      return ('projectId' in data) 
        && data.projectId != null 
        && data.projectId is string 
        && data.projectId.size() > 0;
    }

    // -------------------------------------------------------------
    // PROJECT SCOPE & ISOLATION HELPERS
    // -------------------------------------------------------------

    function isAssignedToProject(projId) {
      let userDoc = getUserDoc();
      let assigned = userDoc.get('assignedProjectIds', []);
      return (projId != null && projId in assigned)
        || (projId != null && exists(/databases/$(database)/documents/projects/$(projId)) && (
          get(/databases/$(database)/documents/projects/$(projId)).data.get('projectLeaderId', '') == request.auth.uid
          || (request.auth.token.email != null && get(/databases/$(database)/documents/projects/$(projId)).data.get('projectLeaderEmail', '') == request.auth.token.email)
          || (request.auth.token.email != null && get(/databases/$(database)/documents/projects/$(projId)).data.get('members', []).hasAny([request.auth.uid, request.auth.token.email]))
          || get(/databases/$(database)/documents/projects/$(projId)).data.get('members', []).hasAny([request.auth.uid])
        ));
    }

    function canAccessProjectForRead(projId) {
      return isOwnerOrAdmin() || isAssignedToProject(projId);
    }

    function canMutateProjectFinance(projId) {
      return isValidId(projId)
        && exists(/databases/$(database)/documents/projects/$(projId))
        && (isOwnerOrAdmin() || isAssignedToProject(projId));
    }

    function canAccessProjectForWrite(projId) {
      return isOwnerOrAdmin() || (getPrincipalRole() == "PROJECT_LEADER" && isAssignedToProject(projId));
    }

    function canAccessProjectForDelete(projId) {
      return isOwnerOrAdmin();
    }

    // -------------------------------------------------------------
    // SCHEMA & FINANCIAL INVARIANT VALIDATORS
    // -------------------------------------------------------------

    function isValidMoneyAmount(v) { 
      return v is int && v >= 0 && v <= 1000000000000000; 
    }

    function isValidPositiveAmount(v) {
      return v is int && v > 0 && v <= 1000000000000000;
    }

    function isValidPercentage(v) {
      return v is number && v >= 0 && v <= 100;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'role', 'isActive', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128
        && data.role is string && data.role in ["OWNER", "ADMIN", "FINANCE", "PROJECT_LEADER", "TEAM", "VIEWER", "CLIENT_VIEWER"]
        && data.isActive is bool
        && data.createdAt is string && data.createdAt.size() <= 60
        && data.updatedAt is string && data.updatedAt.size() <= 60;
    }

    function isValidProject(data) {
      return (!('contractValue' in data) || isValidMoneyAmount(data.contractValue))
        && (!('clientEstimate' in data) || isValidMoneyAmount(data.clientEstimate))
        && (!('vendorBudget' in data) || isValidMoneyAmount(data.vendorBudget));
    }

    function isValidQuotation(data) {
      return (!('grandTotal' in data) || isValidMoneyAmount(data.grandTotal))
        && (!('subTotal' in data) || isValidMoneyAmount(data.subTotal))
        && (!('discount' in data) || isValidMoneyAmount(data.discount))
        && (!('tax' in data) || isValidMoneyAmount(data.tax))
        && (!('taxPercentage' in data) || isValidPercentage(data.taxPercentage));
    }

    function isValidFinanceTerm(data) {
      return (!('percentageValue' in data) || isValidPercentage(data.percentageValue))
        && (!('nominalValue' in data) || isValidMoneyAmount(data.nominalValue))
        && (!('invoicedAmount' in data) || isValidMoneyAmount(data.invoicedAmount));
    }

    function isValidInvoice(data) {
      return (!('grandTotal' in data) || isValidMoneyAmount(data.grandTotal))
        && (!('subTotal' in data) || isValidMoneyAmount(data.subTotal))
        && (!('paidAmount' in data) || isValidMoneyAmount(data.paidAmount))
        && (!('remainingAmount' in data) || isValidMoneyAmount(data.remainingAmount))
        && (!('discount' in data) || isValidMoneyAmount(data.discount))
        && (!('tax' in data) || isValidMoneyAmount(data.tax))
        && (!('taxPercentage' in data) || isValidPercentage(data.taxPercentage));
    }

    function isValidClientPayment(data) {
      return !('amount' in data) || isValidPositiveAmount(data.amount);
    }

    function isValidProjectVendor(data) {
      return !('contractValue' in data) || isValidMoneyAmount(data.contractValue);
    }

    function isValidVendorPaymentTerm(data) {
      return (!('percentageValue' in data) || isValidPercentage(data.percentageValue))
        && (!('nominalValue' in data) || isValidMoneyAmount(data.nominalValue))
        && (!('invoicedAmount' in data) || isValidMoneyAmount(data.invoicedAmount));
    }

    function isValidVendorBill(data) {
      return (!('amount' in data) || isValidPositiveAmount(data.amount))
        && (!('paidAmount' in data) || isValidMoneyAmount(data.paidAmount))
        && (!('remainingAmount' in data) || isValidMoneyAmount(data.remainingAmount));
    }

    function isValidVendorPayment(data) {
      return !('amount' in data) || isValidPositiveAmount(data.amount);
    }

    function isValidProjectExpense(data) {
      return !('amount' in data) || isValidPositiveAmount(data.amount);
    }

    function isValidCashflowEntry(data) {
      return !('amount' in data) || isValidPositiveAmount(data.amount);
    }

    // -------------------------------------------------------------
    // COLLECTION RULES
    // -------------------------------------------------------------

    function isSafeSelfRegistration(data) {
      return data.role == "VIEWER"
        && data.isActive == false
        && data.get('canViewFinance', false) == false
        && data.get('canEditFinance', false) == false
        && data.get('canApproveFinance', false) == false
        && data.get('canExportFinanceReport', false) == false
        && data.get('canVoidFinanceTransaction', false) == false
        && data.get('canEditPaidTransaction', false) == false
        && data.get('canViewVendorCost', false) == false
        && data.get('canViewVendorPayment', false) == false
        && data.get('canManageTransmittal', false) == false
        && (!('assignedProjectIds' in data) || data.assignedProjectIds.size() == 0);
    }

    // USERS COLLECTION (Full Security Profiles - AUD-15: Protected from Arbitrary Active Users)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isOwnerOrAdmin());
      allow list: if isSignedIn() && isOwnerOrAdmin();

      allow create: if isSignedIn() 
        && isValidId(userId)
        && request.auth.uid == userId 
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && (isSafeSelfRegistration(incoming()) || (request.auth.token.email != null && isOwnerEmail(request.auth.token.email)));

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && (
          (request.auth.token.email != null && isOwnerEmail(request.auth.token.email))
          || (
            incoming().createdAt == existing().createdAt
            && (
              (request.auth.uid == userId && (
                incoming().diff(existing()).affectedKeys().hasOnly(['name', 'themePreference', 'updatedAt'])
              ))
              ||
              (isPrincipalActive() && request.auth.uid != userId && isOwnerOrAdmin() && (
                getPrincipalRole() == "OWNER"
                || (getPrincipalRole() == "ADMIN" && existing().get('role', '') != "OWNER" && incoming().get('role', '') != "OWNER")
              ))
            )
          )
        );
      
      allow delete: if isSignedIn() 
        && isPrincipalActive() 
        && request.auth.uid != userId
        && existing().get('role', '') != "OWNER"
        && (getPrincipalRole() == "OWNER" || (getPrincipalRole() == "ADMIN" && existing().get('role', '') != "ADMIN"));
    }

    function isValidUserDirectory(data) {
      return data.keys().hasAll(['uid', 'role', 'isActive'])
        && data.uid is string && data.uid.size() <= 128
        && data.role is string && data.role in ["OWNER", "ADMIN", "FINANCE", "PROJECT_LEADER", "TEAM", "VIEWER", "CLIENT_VIEWER"]
        && data.isActive is bool
        && !('canViewFinance' in data)
        && !('canEditFinance' in data)
        && !('canApproveFinance' in data)
        && !('canExportFinanceReport' in data)
        && !('canVoidFinanceTransaction' in data)
        && !('canEditPaidTransaction' in data)
        && !('canViewVendorCost' in data)
        && !('canViewVendorPayment' in data)
        && !('canManageTransmittal' in data)
        && !('assignedProjectIds' in data);
    }

    // MINIMAL PIC DIRECTORY (AUD-15: Sanitized, zero privileged capabilities or project assignments)
    match /userDirectory/{userId} {
      allow read: if isSignedIn() && isPrincipalActive();
      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidUserDirectory(incoming())
        && incoming().uid == userId
        && (
          (request.auth.uid == userId && incoming().role == "VIEWER" && incoming().isActive == false)
          || (isPrincipalActive() && isOwnerOrAdmin())
        );
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserDirectory(incoming())
        && incoming().uid == existing().uid
        && (
          (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']))
          || (isPrincipalActive() && isOwnerOrAdmin())
        );
      allow delete: if isSignedIn() && isPrincipalActive() && isOwnerOrAdmin();
    }

    // PROJECTS
    match /projects/{projectId} {
      // Legacy documents carrying financial fields must go through the redacting server reader.
      allow read: if isPrincipalActive() && canAccessProjectForRead(projectId)
        && (!resource.data.keys().hasAny(['contractValue','expectedProfit','budgetOtherExpenses','clientEstimate','vendorBudget','targetProfitPercentage']) || canViewFinance());
      allow write: if false; // /api/projects/command validates workflow, fields and archive.
    }

    function validDrawing(d) {
      return d.get('status','') in ['Belum Mulai','Proses','Review','Revisi','Selesai','Hold']
        && d.get('progress',-1) is number && d.progress >= 0 && d.progress <= 100;
    }
    match /projectFinancials/{projectId} {
      allow read: if isPrincipalActive() && canViewFinance() && canAccessProjectForRead(projectId);
      allow write: if false;
    }
    match /notificationStates/{stateId} {
      allow read, delete: if isPrincipalActive() && resource.data.userId == request.auth.uid;
      allow create, update: if isPrincipalActive() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId','notificationId','dismissed','updatedAt']);
    }
    // DRAWING COLLECTIONS (Project-Scoped)
    match /drawingGroups/{groupId} {
      allow read: if isSignedIn() && isPrincipalActive() && canAccessProjectForRead(resource.data.projectId);
      allow create: if isSignedIn() && isPrincipalActive() && canAccessProjectForWrite(incoming().projectId);
      allow update: if isSignedIn() && isPrincipalActive() && canAccessProjectForWrite(resource.data.projectId) && incoming().projectId == resource.data.projectId;
      allow delete: if isSignedIn() && isPrincipalActive() && canAccessProjectForDelete(resource.data.projectId);
    }

    match /drawingItems/{itemId} {
      allow read: if isSignedIn() && isPrincipalActive() && canAccessProjectForRead(resource.data.projectId);
      allow create: if isSignedIn() && isPrincipalActive() && canAccessProjectForWrite(incoming().projectId) && validDrawing(incoming());
      allow delete: if isSignedIn() && isPrincipalActive() && canAccessProjectForDelete(resource.data.projectId);
      allow update: if isSignedIn() && isPrincipalActive() && incoming().projectId == resource.data.projectId && validDrawing(incoming()) && (
        canAccessProjectForWrite(resource.data.projectId) || (
          getPrincipalRole() == "TEAM" &&
          isAssignedToProject(resource.data.projectId) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'progress', 'notes', 'updatedAt'])
        )
      );
    }

    match /drawingRevisions/{revisionId} {
      allow read: if isSignedIn() && isPrincipalActive() && canAccessProjectForRead(resource.data.projectId);
      allow create: if isSignedIn() && isPrincipalActive() && canAccessProjectForWrite(incoming().projectId);
      allow update: if isSignedIn() && isPrincipalActive() && canAccessProjectForWrite(resource.data.projectId) && incoming().projectId == resource.data.projectId;
      allow delete: if isSignedIn() && isPrincipalActive() && canAccessProjectForDelete(resource.data.projectId);
    }

    match /drawingTransmittals/{transmittalId} {
      allow read: if isSignedIn() && isPrincipalActive() && canAccessProjectForRead(resource.data.projectId);
      allow create: if isSignedIn() && isPrincipalActive() && canManageTransmittal() && canAccessProjectForRead(incoming().projectId);
      allow update: if isSignedIn() && isPrincipalActive() && canAccessProjectForWrite(resource.data.projectId) && incoming().projectId == resource.data.projectId;
      allow delete: if isSignedIn() && isPrincipalActive() && canManageTransmittal() && canAccessProjectForDelete(resource.data.projectId);
    }

    // DRAWING TEMPLATES (Global Master Data)
    match /drawingTemplates/{templateId} {
      allow read: if isSignedIn() && isPrincipalActive();
      allow create, update, delete: if isSignedIn() && isOwnerOrAdmin();
    }

    match /drawingTemplateGroups/{groupId} {
      allow read: if isSignedIn() && isPrincipalActive();
      allow create, update, delete: if isSignedIn() && isOwnerOrAdmin();
    }

    match /drawingTemplateItems/{itemId} {
      allow read: if isSignedIn() && isPrincipalActive();
      allow create, update, delete: if isSignedIn() && isOwnerOrAdmin();
    }

    // AUDIT LOGS (Immutable)
    match /activityLogs/{logId} {
      allow read: if isSignedIn() && isPrincipalActive() && (!('projectId' in resource.data) || canAccessProjectForRead(resource.data.projectId));
      allow create: if isPrincipalActive() && incoming().userId == request.auth.uid && incoming().get('userRole','') == getPrincipalRole() && (!hasAssociatedProject(incoming()) || canAccessProjectForRead(incoming().projectId));
      allow update, delete: if false; // Immutable audit logs
    }

    match /financialAuditLogs/{logId} {
      allow read: if isPrincipalActive() && canViewFinance() && canAccessProjectForRead(resource.data.projectId);
      allow write: if false;
    }

    // CLIENTS MASTER DATA
    match /clients/{clientId} {
      allow read: if isSignedIn() && isPrincipalActive() && canViewFinance();
      allow create, update: if isSignedIn() && isPrincipalActive() && canEditFinance();
      allow delete: if false;
    }

    // FINANCE COLLECTIONS (Project-Scoped & Pipeline Quotations - AUD-07 & AUD-08)
    match /quotations/{quotationId} {
      // Must have canViewFinance() and proper scope to read quotation price and data (AUD-07)
      allow read: if isSignedIn() && isPrincipalActive() && canViewFinance() && (
        isOwnerOrAdmin() ||
        (!hasAssociatedProject(resource.data) && (resource.data.get('createdBy', '') == request.auth.uid || isCompanyWideFinanceRole())) ||
        (hasAssociatedProject(resource.data) && canAccessProjectForRead(resource.data.projectId))
      );

      allow write: if false; // Quotation calculations, scope and audit are enforced by server commands.
    }

    match /financeTerms/{termId} {
      allow read: if isPrincipalActive() && canViewFinance() && canAccessProjectForRead(resource.data.projectId);
      allow write: if false; // Only authenticated transactional server commands may mutate finance.
    }

    match /invoices/{invoiceId} {
      allow read: if isPrincipalActive() && canViewFinance() && canAccessProjectForRead(resource.data.projectId);
      allow write: if false; // Only authenticated transactional server commands may mutate finance.
    }

    match /clientPayments/{paymentId} {
      allow read: if isPrincipalActive() && canViewFinance() && canAccessProjectForRead(resource.data.projectId);
      allow write: if false; // Only authenticated transactional server commands may mutate finance.
    }

    // VENDOR COLLECTIONS (Project-Scoped)
    match /vendors/{vendorId} {
      allow read: if isSignedIn() && isPrincipalActive() && (canViewVendorCost() || canViewFinance());
      allow create, update: if isSignedIn() && isPrincipalActive() && canEditFinance();
      allow delete: if false;
    }

    match /projectVendors/{contractId} {
      allow read: if isPrincipalActive() && canViewFinance() && canAccessProjectForRead(resource.data.projectId);
      allow write: if false; // Only authenticated transactional server commands may mutate finance.
    }

    match /vendorPaymentTerms/{termId} {
      allow read: if isPrincipalActive() && canViewFinance() && canAccessProjectForRead(resource.data.projectId);
      allow write: if false; // Only authenticated transactional server commands may mutate finance.
    }

    match /vendorBills/{billId} {
      allow read: if isPrincipalActive() && canViewFinance() && canAccessProjectForRead(resource.data.projectId);
      allow write: if false; // Only authenticated transactional server commands may mutate finance.
    }

    match /vendorPayments/{paymentId} {
      allow read: if isPrincipalActive() && canViewFinance() && canAccessProjectForRead(resource.data.projectId);
      allow write: if false; // Only authenticated transactional server commands may mutate finance.
    }

    // EXPENSES & CASHFLOW (Project-Scoped)
    match /projectExpenses/{expenseId} {
      allow read: if isPrincipalActive() && canViewFinance() && canAccessProjectForRead(resource.data.projectId);
      allow write: if false; // Only authenticated transactional server commands may mutate finance.
    }

    match /cashflowEntries/{entryId} {
      allow read: if isPrincipalActive() && canViewFinance() && canAccessProjectForRead(resource.data.projectId);
      allow write: if false; // Only authenticated transactional server commands may mutate finance.
    }

    // SYSTEM & METADATA
    match /aiAuditLogs/{logId} {
      allow read: if isSignedIn() && isPrincipalActive() && isOwnerOrAdmin();
      allow create: if false; // AI action audit is authored atomically by the server.
      allow update, delete: if false; // Immutable audit trail
    }

    match /documentCounters/{counterId} {
      allow read: if isSignedIn() && isPrincipalActive() && (canViewFinance() || isOwnerOrAdmin() || canManageTransmittal());
      allow create, update: if counterId == 'transmittal' && isSignedIn() && isPrincipalActive() && canManageTransmittal();
      allow delete: if false;
    }

    match /pdfTemplates/{templateId} {
      allow read: if isSignedIn() && isPrincipalActive();
      allow create, update, delete: if isSignedIn() && isOwnerOrAdmin();
    }

    match /companySettings/{settingId} {
      allow read: if isSignedIn() && isPrincipalActive();
      allow create, update, delete: if isSignedIn() && isOwnerOrAdmin();
    }

    match /generatedDocuments/{documentId} {
      allow read: if isPrincipalActive() && hasAssociatedProject(resource.data) && canAccessProjectForRead(resource.data.projectId)
        && (resource.data.get('documentType','') == 'DrawingTransmittal' || canViewFinance());
      allow create: if isPrincipalActive() && hasAssociatedProject(incoming()) && canAccessProjectForRead(incoming().projectId)
        && incoming().createdBy == request.auth.uid
        && (incoming().get('documentType','') == 'DrawingTransmittal' ? canManageTransmittal() : canEditFinance());
      allow update, delete: if false;
    }

    match /systemSettings/{settingId} {
      allow read, write: if false; // Bootstrap seal and provider secrets are server-only.
    }
  }
}

