# Server environment only. Do not prefix secrets with VITE_.
# Use platform-managed identity/ADC with least privilege where available; never commit credentials.
FIREBASE_SERVICE_ACCOUNT_KEY=
MDRAWING_FIREBASE_CONFIG=
MDRAWING_FIRESTORE_DATABASE_ID=default
HOST=127.0.0.1
PORT=3888
NODE_ENV=development
APP_URL=
# AI is intentionally disabled until the operator sets provider keys and explicit limits.
AI_ENABLED=false
GEMINI_API_KEY=
UPSTAGE_API_KEY=
AI_DAILY_TOKEN_LIMIT=
AI_DAILY_BUDGET_IDR=
AI_PRICE_CEILING_IDR_PER_MILLION_TOKENS=
AI_USER_DAILY_REQUEST_LIMIT=50
# Preview is non-production JSON output only, not real email delivery.
MAIL_PREVIEW=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
